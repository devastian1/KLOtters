{
  "entities": {
    "Sighting": {
      "title": "Sighting",
      "description": "A real-time river otter sighting logged around Kuala Lumpur with photo and coordinates.",
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "species": {
          "type": "string",
          "enum": [
            "Smooth-coated Otter",
            "Asian Small-clawed Otter",
            "Hairy-nosed Otter",
            "Unsure"
          ]
        },
        "count": {
          "type": "integer"
        },
        "activity": {
          "type": "string",
          "enum": [
            "Swimming",
            "Foraging",
            "Basking",
            "Grooming",
            "Crossing"
          ]
        },
        "corridor": {
          "type": "string",
          "enum": [
            "Perdana Botanical Gardens",
            "Titiwangsa Lake",
            "Klang River",
            "Gombak River",
            "Taman Jaya Lake",
            "Kepong Metropolitan",
            "Other KL Waterway"
          ]
        },
        "locationName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 600
        },
        "photoUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 350000
        },
        "confirmations": {
          "type": "integer"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "authorId",
        "authorName",
        "title",
        "species",
        "count",
        "activity",
        "corridor",
        "locationName",
        "lat",
        "lng",
        "notes",
        "photoUrl",
        "confirmations",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "Confirmation": {
      "title": "Confirmation",
      "description": "A community spotter confirmation attached atomically to a sighting.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "userName",
        "visibility",
        "createdAt"
      ]
    },
    "Comment": {
      "title": "Comment",
      "description": "A live field note or direction update on a Kuala Lumpur otter sighting.",
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "authorId",
        "authorName",
        "text",
        "visibility",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/sightings/{sightingId}": {
      "schema": {
        "$ref": "#/entities/Sighting"
      },
      "description": "Real-time Kuala Lumpur otter sightings with coordinates, species, and photo."
    },
    "/sightings/{sightingId}/confirmations/{userId}": {
      "schema": {
        "$ref": "#/entities/Confirmation"
      },
      "description": "Per-user confirmation records synchronized atomically with sighting confirmation count."
    },
    "/sightings/{sightingId}/comments/{commentId}": {
      "schema": {
        "$ref": "#/entities/Comment"
      },
      "description": "Field notes and movement updates left by spotters on a sighting."
    }
  }
}
